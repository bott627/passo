{
  "name": "passo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fare lookup for Gambian public transport — the API and the web app it feeds.",
  "scripts": {
    "dev": "node --watch api/server.js",
    "start": "node api/server.js",
    "db:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "setup": "prisma db push && node prisma/seed.js",
    "reset": "prisma db push --force-reset && node prisma/seed.js",
    "test": "node --test",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
